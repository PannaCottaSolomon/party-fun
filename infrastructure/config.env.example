# Settings for deploy.sh and add-user.sh. Copy to config.env (git-ignored) and edit.
# No secrets go here: AWS credentials come from `aws configure` / `aws sso login`, and app secrets live in
# AWS Secrets Manager.

# Region for every stack (Singapore).
AWS_REGION=ap-southeast-1

# Prefix for stack, resource and export names (lowercase), e.g. partyfun-cognito.
STACK_PREFIX=partyfun

# Named AWS CLI profile to use; leave empty to use your default credentials.
AWS_PROFILE=

# Where the backend runs (ECS). Leave both empty to use the account's default VPC and its default subnets.
# Otherwise: VPC_ID=vpc-..., SUBNET_IDS=subnet-aaa,subnet-bbb (at least two Availability Zones).
VPC_ID=
SUBNET_IDS=

# Your IP as x.x.x.x/32 to open the RabbitMQ management UI (port 15672) and connect on 5672 for testing.
# Find it with: curl -s https://checkip.amazonaws.com. The default allows no one.
RABBITMQ_ADMIN_CIDR=127.0.0.1/32

# Your IP as x.x.x.x/32 to open the Jaeger UI (port 16686). The default allows no one.
JAEGER_ADMIN_CIDR=127.0.0.1/32

# The React app to build and upload (relative to this folder).
FRONTEND_DIR=../user-interfaces/frontend
