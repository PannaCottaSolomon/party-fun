# Copy to .env and fill in. Never commit .env (it's in .gitignore).

APP_NAME=Campus Events
PORT=5000

# RabbitMQ (the docker compose hostname is "rabbitmq")
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/%2F
NOTIFICATION_EXCHANGE=notifications
NOTIFICATION_QUEUE=notification_service
# Wait before retry 1, 2, 3 (ms): 30s, 2m, 10m. One retry per value, then the email is discarded.
RETRY_DELAYS_MS=30000,120000,600000
ENABLE_CONSUMER=true

# Resend: leave RESEND_API_KEY empty (or EMAIL_DRY_RUN=true) to log emails instead of sending.
RESEND_API_KEY=
EMAIL_FROM=Campus Events <onboarding@resend.dev>
EMAIL_DRY_RUN=true
ADMIN_EMAIL=admin@example.com
# Testing: send every email to this inbox instead (the real recipient goes in the subject).
# Resend's test sender (onboarding@resend.dev) only delivers to your Resend account's address.
EMAIL_REDIRECT_TO=
# User directory: user.* messages from the Authentication service (defaults shown).
# USER_EXCHANGE=user.events
# USER_QUEUE=notifications.users
# USER_DIRECTORY_ENABLED=true

# Notification log + duplicate check. Local file by default; on AWS use RDS MySQL:
#   DATABASE_URL=mysql://user:password@your-rds-endpoint:3306/notifications
DATABASE_URL=sqlite:///data/notifications.db

# Callers of the HTTP endpoints must send this in an X-API-Key header (empty = no check).
# Change it for anything beyond local testing; the Bruno collection uses dev-api-key.
API_KEY=dev-api-key

# Seconds to finish the current message when the container is stopped.
SHUTDOWN_TIMEOUT_S=25

LOG_LEVEL=INFO
# text (readable) or json (one JSON object per line, includes trace ids)
LOG_FORMAT=text

# Tracing: set to true and start compose with --profile tracing to send traces to Jaeger
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
# Not traced: GET /notifications (its URL carries email addresses) and the health checks (noise).
OTEL_PYTHON_FLASK_EXCLUDED_URLS=[^/]/notifications(?!-),/health,/ready
