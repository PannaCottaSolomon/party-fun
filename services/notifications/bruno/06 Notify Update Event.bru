meta {
  name: Notify Update Event
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/notify_update_event
  body: json
  auth: none
}

headers {
  X-API-Key: {{apiKey}}
}

body:json {
  {
    "notification_id": "event_updated-{{runId}}",
    "email": "participant@example.com",
    "name": "Alex",
    "event_title": "Off-campus Beach Day",
    "event_id": 77,
    "changes": {
      "location": "Sentosa, Palawan Beach",
      "start time": "11:00 AM"
    },
    "audience": "participant"
  }
}

script:pre-request {
  bru.setVar("runId", Date.now());
}

assert {
  res.status: eq 200
  res.body.status: eq sent
}
