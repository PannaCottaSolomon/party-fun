# Copy to dev.env (git-ignored) and fill in. The service reads ./dev.env automatically when started
# from this folder; real environment variables override it. Never commit real Stripe keys or the admin key.
# The same file feeds `docker compose up -d --build` (compose.yaml, which points db_host and rabbitmq_host at
# host.docker.internal and its own RabbitMQ container).

stage=dev

db_host=localhost
db_port=3306
db_name=payment
db_user=g4t2
db_password=g4t2

rabbitmq_host=localhost
rabbitmq_port=5672
rabbitmq_username=guest
rabbitmq_password=guest

# Stripe SANDBOX only (real Stripe API, no real money). Secret key (sk_test_...): Stripe Dashboard > account picker >
# Sandboxes > your sandbox > Developers > API keys. A live key (sk_live_...) stops the service from starting.
# (STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET are accepted too.)
stripe_secret_key=
# Webhook signing secret (whsec_...): printed by `stripe listen --forward-to localhost:8080/payments/webhook/stripe`.
# Required: unsigned webhooks are rejected.
stripe_webhook_secret=
# Publishable key (pk_test_..., same API keys page). Public by design: GET /payments/config hands it to the
# frontend's Stripe card form. Only pk_test_ keys are accepted.
stripe_publishable_key=

# Admins are recognised by their JWT (Authorization: Bearer <token> with role ADMIN), verified with the JWT
# issuer's shared HS256 secret: put the same value as the Authentication Service's AUTH_JWT_SECRET (>= 32 bytes).
auth_jwt_secret=
# Optional: required "iss" claim, once the issuer sets one (e.g. after the Event/Authentication merge).
# auth_jwt_issuer=

# Operator fallback for the Admin endpoints (X-Admin-Api-Key header), e.g. while the issuer can't issue ADMIN
# tokens yet. Make one up, e.g. `openssl rand -hex 32`. Empty = off.
payment_admin_api_key=
# A DIFFERENT secret for internal service-to-service refunds (X-Service-Api-Key header), e.g. the Event Service's
# compensation refund. Accepted only on POST /payments/{id}/refund. Give the Event Service the same value.
payment_service_api_key=

# The frontend's origins: npm run dev (5173) and its Docker site (8001).
cors_allowed_origins=http://localhost:5173,http://localhost:8001

# Optional
# refund_max_attempts=3
# refund_backoff_ms=1000
# admin_alert_enabled=true      # publish notify.admin_alert to the Notification Service on refund failure
# rabbitmq_management_url=http://localhost:15672   # DLQ counts for the Admin dashboard
# port=8080
