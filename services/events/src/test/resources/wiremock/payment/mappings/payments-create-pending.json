{
  "name": "POST /payments with any other payment method: PENDING (the card needs more customer action, e.g. 3-D Secure)",
  "priority": 9,
  "request": {
    "method": "POST",
    "url": "/payments"
  },
  "response": {
    "status": 201,
    "headers": { "Content-Type": "application/json" },
    "body": "{\"paymentId\": {{jsonPath request.body '$.bookingId'}}, \"bookingId\": {{jsonPath request.body '$.bookingId'}}, \"currency\": \"SGD\", \"status\": \"PENDING\"}",
    "transformers": ["response-template"]
  }
}
