<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<!-- Spring Boot parent: provides managed dependency versions and default plugin configuration -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<!-- Project coordinates (the built jar is target/events-0.0.1-SNAPSHOT.jar) -->
	<groupId>com.example</groupId>
	<artifactId>events</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<!-- Empty overrides stop these elements being inherited from the Spring Boot parent (see HELP.md) -->
	<name/>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>

		<!-- Security overrides of versions managed by Spring Boot 4.1.1 (found by the CI container scan, Trivy).
		     Patch / compatible releases only. Remove each one once a Spring Boot release manages that version or newer.
		     tomcat 11.0.24 -> 11.0.27: CRITICAL CVE-2026-65182, CVE-2026-65905, CVE-2026-68525 (fixed in 11.0.25)
		     jackson 3.1.5 -> 3.1.8:    HIGH CVE-2026-68497, -89407, -89425, -91776, -91777 (fixed in 3.1.6 / 3.1.7)
		     amqp-client 5.30.0 -> 5.34.0: HIGH CVE-2026-63337, -69219, -69220, -75516 (fixed in 5.33.0 to 5.34.0) -->
		<tomcat.version>11.0.27</tomcat.version>
		<jackson-bom.version>3.1.8</jackson-bom.version>
		<rabbit-amqp-client.version>5.34.0</rabbit-amqp-client.version>

		<!-- JUnit tag expression of the integration tests Failsafe runs: everything but the chaos tests by default,
		     only them with -Pchaos -->
		<it.groups>!chaos</it.groups>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
		</dependency>

		<!-- REST API: Spring MVC + embedded Tomcat + JSON (Jackson) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!-- Actuator: /actuator/health liveness and readiness probes (Docker HEALTHCHECK, Compose, CI smoke test, orchestrators) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!-- Distributed tracing: OpenTelemetry spans for HTTP and RabbitMQ, exported over OTLP to Jaeger -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-opentelemetry</artifactId>
		</dependency>
		<!-- Spring's RestClient.Builder (used by PaymentClient), so calls to Payment carry the trace -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-restclient</artifactId>
		</dependency>

		<!-- Automatic restart / live reload during local development (excluded from packaged jars) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>

		<!-- Lombok: annotation-based boilerplate generation (currently unused; getters/setters are hand-written) -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- Bean Validation (enables @Valid on request bodies) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- Test support: JUnit, Mockito, AssertJ, Spring Boot test, MockMvc -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Integration tests (*IT, run by Failsafe): throw-away PostgreSQL and RabbitMQ containers.
		     Versions come from the Testcontainers BOM managed by Spring Boot. Needs a Docker daemon. -->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-rabbitmq</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Chaos tests (*ChaosIT): Toxiproxy between the service and RabbitMQ, to take the broker away mid-test -->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-toxiproxy</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- WireMock: stands in for the payment service in unit, integration and chaos tests (and in compose.yaml),
		     with its default stubs in src/test/resources/wiremock/payment. The standalone jar shades its own Jetty
		     and Jackson, so they cannot clash with Spring Boot's. Not managed by Spring Boot, so it is pinned. -->
		<dependency>
			<groupId>org.wiremock</groupId>
			<artifactId>wiremock-standalone</artifactId>
			<version>3.13.2</version>
			<scope>test</scope>
		</dependency>

		<!-- Awaitility: integration and chaos tests wait for asynchronous effects without fixed sleeps -->
		<dependency>
			<groupId>org.awaitility</groupId>
			<artifactId>awaitility</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- JdbcTemplate / DataSource -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc</artifactId>
		</dependency>

		<!-- Spring Data JPA + Hibernate: entities and repositories for the events and bookings tables -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- RabbitMQ (AMQP) client: RabbitTemplate for publishing messages -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-amqp</artifactId>
		</dependency>

		<!-- Spring Retry: @Retryable on BookingReservationService.reserve() (version not managed by Boot 4, so it is pinned) -->
		<dependency>
			<groupId>org.springframework.retry</groupId>
			<artifactId>spring-retry</artifactId>
			<version>2.0.12</version>
		</dependency>

		<!-- AspectJ support needed by Spring Retry's annotation-driven proxies -->
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-aspects</artifactId>
		</dependency>

		<!-- PostgreSQL JDBC driver (needed only at runtime) -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

	</dependencies>

	<build>
		<plugins>
			<!-- Builds the executable jar (mvnw package) and runs the app (mvnw spring-boot:run).
			     Also builds a Docker image with Cloud Native Buildpacks (mvnw spring-boot:build-image). -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				 <configuration>
                    <!-- Docker Desktop's Windows named pipe (remove or change this on macOS/Linux) -->
                    <docker>
                        <host>//./pipe/dockerDesktopLinuxEngine</host>
                    </docker>
                    <!-- Paketo buildpack builder and run images used by spring-boot:build-image -->
                    <image>
                        <builder>paketobuildpacks/builder:base</builder>
                        <runImage>paketobuildpacks/run:base-cnb</runImage>
                    </image>
                </configuration>
			</plugin>

			<!-- Integration tests: runs *IT classes in the integration-test phase (mvnw verify); unit tests (*Test)
			     stay with Surefire in the test phase. Skip them with -DskipITs. Goals are bound by the Boot parent.
			     Chaos tests (*ChaosIT, JUnit tag "chaos") are left out here and run with -Pchaos (profile below). -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<configuration>
					<groups>${it.groups}</groups>
				</configuration>
			</plugin>

			<!-- Code coverage: one agent for unit and integration tests (both append to target/jacoco.exec, so run
			     "clean verify" for accurate numbers); the HTML/XML/CSV report is written to target/site/jacoco/ in the
			     verify phase, then the build fails if line coverage drops below 85% or branch coverage below 75%
			     (unit tests alone reach about 90% / 81%). -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.13</version>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
					<execution>
						<id>check</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.85</minimum>
										</limit>
										<limit>
											<counter>BRANCH</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.75</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- Chaos experiments only: mvnw verify -Pchaos (the CI chaos-tests job). Runs the *ChaosIT classes, which
		     inject faults into the payment service (WireMock) and the broker (Toxiproxy), without the unit tests and
		     without the coverage gate, which is measured over the unit and integration tests. -->
		<profile>
			<id>chaos</id>
			<properties>
				<it.groups>chaos</it.groups>
				<jacoco.skip>true</jacoco.skip>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<configuration>
							<skipTests>true</skipTests>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
