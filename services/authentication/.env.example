# Template for .env (which is gitignored). Copy it and fill in real values:
#     cp .env.example .env
# Override every value in real environments; never commit a filled-in .env.

# The team's Cognito user pool (same AWS_REGION / COGNITO_USER_POOL_ID as the events service).
AWS_REGION=ap-southeast-1
COGNITO_USER_POOL_ID=
# The frontend's app client: WITHOUT a client secret, with ALLOW_USER_PASSWORD_AUTH and ALLOW_REFRESH_TOKEN_AUTH.
COGNITO_CLIENT_ID=

# AWS credentials for the Cognito admin calls (local dev only; in AWS use the task/pod role).
# Learner Lab credentials also need the session token.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# The single platform ADMIN account, seeded into Cognito (group "admin") on startup
# (see AdminBootstrap). ADMIN can never be chosen by a user. The password must
# meet the user pool's policy (default: 8+ chars, upper, lower, digit, symbol). Leave
# it blank to skip seeding the admin.
ADMIN_BOOTSTRAP_EMAIL=admin@partyfun.local
# Only for a pool that signs in with usernames (email as an alias): a plain username, e.g. admin.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Platform Admin

# Browser origins allowed to call this API (comma-separated). Default: the frontend dev server.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Must new accounts enter the code Cognito emails? false (current) = the frontend confirms them without it.
# Turn on before real users sign up.
EMAIL_VERIFICATION_ENABLED=false
