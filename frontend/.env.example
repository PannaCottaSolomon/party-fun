# Copy to .env and fill in:   cp .env.example .env
# Read by `docker compose up -d --build` (compose.yaml) and by `npm run dev`. .env is git-ignored and never goes into
# the Docker image; never commit it.

# ---------- Public: baked into the JavaScript at build time (never secrets)
# The Cognito user pool's public app client: CloudFormation -> partyfun-cognito -> Outputs -> AppClientId.
VITE_COGNITO_REGION=ap-southeast-1
VITE_COGNITO_CLIENT_ID=
# Where the browser reaches the Event Service. Locally /gw, which nginx (Docker, :8001) and the npm run dev server
# forward to it. Deployed: the API Gateway URL (partyfun-api -> Outputs -> ApiUrl).
VITE_API_BASE_URL=/gw
# The Payment and Authentication Services as the browser reaches them (their published ports on this machine).
VITE_PAYMENT_API_URL=http://localhost:8080
VITE_USER_API_URL=http://localhost:8082

# ---------- Secret: only this app's server gets these (nginx in Docker, the npm run dev server), never the browser
# The same values as payment_admin_api_key / payment_service_api_key in services/payment/dev.env. Empty = the
# forwarded Admin dashboard and cancellation-refund calls are refused (401).
payment_admin_api_key=
payment_service_api_key=

# ---------- Optional, Docker only: where nginx reaches the services from inside its container
# PAYMENT_UPSTREAM=http://host.docker.internal:8080
# EVENTS_UPSTREAM=http://host.docker.internal:8083
# AUTH_UPSTREAM=http://host.docker.internal:8082
